# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_FREE: Optional. Digunakan sebagai API key gratis untuk lapis pertama.
# Jika limit (quota exceeded) tercapai pada key gratis, otomatis fallback ke GEMINI_API_KEY.
GEMINI_API_KEY_FREE=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Storage Integration (Primary Database - Sales & Core)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase Media & Assets Integration (Secondary Database - Photos, Seragam, Motivasi)
SUPABASE_MEDIA_URL="https://wkwjmwxxdfxyfqaseuha.supabase.co"
SUPABASE_MEDIA_KEY="sb_publishable_ZPTUqIJyJzSTb0Jazx_7ZQ_J3ciuWIH"

